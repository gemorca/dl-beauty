<file path="js/admin-keuangan.js">
// Panel admin Tahap 7: Keuangan dan Ulasan.
// Dimuat oleh admin.js. Setiap kali tab dibuka, data diminta ulang dari server (data
// lama tetap tampil selagi memuat), supaya angka selalu sama dengan sheet.
import { h, rupiah, stars, tanggal } from './util.js';
import { adminFinance, adminAddExpense, adminReviews, adminDeleteReview } from './admin-api.js';
import { setLoading, setBar, barFull, closeDialog } from './ui.js';
import { skKeuangan, skUlasan } from './skeleton.js';

const CARA_LABEL = { antar: 'Antar', ambil: 'Ambil', cod: 'COD' };

// Uang bisa negatif (laba rugi): tanda minus di depan "Rp".
const uang = (n) => (n < 0 ? '-' + rupiah(-n) : rupiah(n));

function dayLabel(key) {
  return new Date(key + 'T00:00:00Z').toLocaleDateString('id-ID',
    { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
}

function jam(iso) {
  const d = new Date(iso);
  return isNaN(d) ? '' : d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
}

function newReqId() {
  return (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Date.now()) + '-' + Math.random().toString(16).slice(2);
}

// ctx: { panels:{keuangan, ulasan}, formDialog, toast, confirmDialog, handleAuth }
export function mountKeuangan(ctx) {
  const { panels, formDialog, toast, confirmDialog, handleAuth } = ctx;
  let fin = null;
  let rev = null;
  let loadingFin = false;
  let loadingRev = false;
  let alive = true;
  let busy = false;

  /* ---------- Keuangan ---------- */
  function statCard(label, val, neg) {
    return h('div', { class: 'stat' }, h('span', { class: 'stat-label' }, label),
      h('strong', { class: 'stat-val' + (neg ? ' is-neg' : '') }, val));
  }

  function hariSection(g, hariIni) {
    const rows = [];
    g.pesanan.forEach((p) => rows.push(h('div', { class: 'trow' },
      h('span', { class: 'trow-main' }, '#' + p.id + ' ' + p.nama),
      h('span', { class: 'trow-meta' }, (CARA_LABEL[p.cara_terima] || p.cara_terima) + (p.cara_bayar ? ' \u00b7 ' + p.cara_bayar : '')),
      h('span', { class: 'tag tag-masuk' }, 'Masuk'),
      h('span', { class: 'trow-total' }, '+ ' + rupiah(p.total)))));
    g.pengeluaran.forEach((x) => rows.push(h('div', { class: 'trow' },
      h('span', { class: 'trow-main' }, x.keterangan),
      h('span', { class: 'trow-meta' }, jam(x.waktu)),
      h('span', { class: 'tag tag-keluar' }, 'Keluar'),
      h('span', { class: 'trow-total is-out' }, '- ' + rupiah(x.jumlah)))));

    return h('section', { class: 'day' },
      h('h3', { class: 'day-head' },
        h('span', null, dayLabel(g.hari) + (g.hari === hariIni ? ' (hari ini)' : '')),
        h('span', { class: 'day-sum' },
          'Masuk ' + rupiah(g.masuk) + ' \u00b7 Keluar ' + rupiah(g.keluar) + ' \u00b7 ',
          h('span', { class: g.laba < 0 ? 'is-neg' : '' }, (g.laba < 0 ? 'Rugi ' : 'Laba ') + rupiah(Math.abs(g.laba))))),
      rows.length ? rows : h('p', { class: 'empty' }, 'Tidak ada uang masuk atau keluar.'));
  }

  function renderKeuangan() {
    const r = fin.ringkasan;
    panels.keuangan.replaceChildren(
      h('div', { class: 'toolbar' },
        h('h2', { class: 'section-title' }, 'Keuangan ' + fin.hari.length + ' hari terakhir'),
        h('button', { class: 'btn btn-solid', type: 'button', onclick: openPengeluaran }, 'Catat uang keluar')),
      h('div', { class: 'stats' },
        statCard('Uang masuk', rupiah(r.masuk)),
        statCard('Uang keluar', rupiah(r.keluar)),
        statCard(r.laba < 0 ? 'Rugi' : 'Laba', uang(r.laba), r.laba < 0),
        statCard('Pesanan terbayar', String(r.n_masuk))),
      h('p', { class: 'muted fin-note' },
        'Uang masuk: pesanan antar yang pembayaran QRIS-nya sudah diterima, serta pesanan ambil/COD yang sudah diserahkan (tunai diterima). ' +
        'Pesanan dibatalkan tidak dihitung. Dikelompokkan menurut hari pesanan dibuat. Pengembalian uang ke pelanggan dicatat sebagai uang keluar.'),
      h('h2', { class: 'section-title fin-sub' }, 'Rincian per hari'),
      ...fin.hari.map((g) => hariSection(g, fin.hari_ini)));
  }

  async function loadFin() {
    if (loadingFin) return;
    loadingFin = true;
    if (!fin) panels.keuangan.replaceChildren(...skKeuangan());
    try {
      const res = await adminFinance();
      if (!alive) return;
      fin = res;
      renderKeuangan();
    } catch (e) {
      if (!alive || handleAuth(e)) return;
      if (!fin) {
        panels.keuangan.replaceChildren(h('div', { class: 'state' },
          h('p', null, (e && e.message) || 'Data belum bisa dimuat.'),
          h('button', { class: 'btn btn-solid', type: 'button', onclick: loadFin }, 'Coba lagi')));
      }
    } finally {
      loadingFin = false;
    }
  }

  function openPengeluaran() {
    let saving = false;
    let reqId = newReqId();
    const err = h('p', { class: 'form-error', role: 'alert' });
    const jumlah = h('input', { id: 'ex-jumlah', class: 'input', type: 'text', inputmode: 'numeric', autocomplete: 'off', 'aria-describedby': 'ex-jumlah-info' });
    const info = h('p', { id: 'ex-jumlah-info', class: 'muted field-hint', 'aria-live': 'polite' });
    const paint = () => {
      const n = Number(jumlah.value.replace(/\D/g, ''));
      info.textContent = n >= 1 ? rupiah(n) : 'Isi angka saja, tanpa titik.';
    };
    jumlah.addEventListener('input', () => { jumlah.value = jumlah.value.replace(/\D/g, '').slice(0, 10); paint(); });
    paint();
    const ket = h('input', { id: 'ex-ket', class: 'input', type: 'text', maxlength: '120', autocomplete: 'off', placeholder: 'mis. beli botol, ongkir, iklan' });
    const batal = h('button', { class: 'btn', type: 'button', onclick: () => closeDialog(formDialog) }, 'Batal');
    const simpan = h('button', { class: 'btn btn-solid', type: 'submit' }, 'Simpan');

    const form = h('form', { novalidate: true },
      h('label', { for: 'ex-jumlah', class: 'label' }, 'Jumlah (Rp)'), jumlah, info,
      h('label', { for: 'ex-ket', class: 'label' }, 'Untuk apa'), ket,
      err,
      h('div', { class: 'confirm-actions' }, batal, simpan));

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (saving) return;
      err.textContent = '';
      const n = Number(jumlah.value.replace(/\D/g, ''));
      const k = ket.value.replace(/\s+/g, ' ').trim();
      if (!(n >= 1)) { err.textContent = 'Jumlah wajib diisi.'; jumlah.focus(); return; }
      if (k.length < 2) { err.textContent = 'Tulis untuk apa uang ini keluar.'; ket.focus(); return; }
      saving = true;
      setBar(simpan, true, 'Menyimpan\u2026');
      try {
        const res = await adminAddExpense(n, k, reqId);
        await barFull(simpan);
        if (!alive) return;
        fin = res;
        reqId = newReqId();
        closeDialog(formDialog);
        renderKeuangan();
        toast('Uang keluar dicatat: ' + rupiah(n));
      } catch (e) {
        if (e && e.code === 'AUTH') { if (formDialog.open) formDialog.close(); handleAuth(e); return; }
        err.textContent = (e && e.message) || 'Gagal menyimpan.';
      } finally {
        saving = false;
        setBar(simpan, false, 'Simpan');
      }
    });

    formDialog.replaceChildren(h('div', { class: 'sheet-inner' },
      h('div', { class: 'sheet-head' },
        h('h2', { id: 'formTitle', class: 'sheet-title' }, 'Catat uang keluar'),
        h('button', { class: 'icon-btn', type: 'button', 'aria-label': 'Tutup', onclick: () => closeDialog(formDialog) }, '\u00d7')),
      form));
    formDialog.showModal();
    jumlah.focus();
  }

  /* ---------- Ulasan ---------- */
  function ulasanCard(u) {
    return h('article', { class: 'rcard' },
      h('div', { class: 'ocard-head' },
        h('strong', null, u.nama || 'Pelanggan'),
        h('span', { class: 'ocard-time' }, tanggal(u.waktu))),
      h('p', { class: 'rcard-stars', role: 'img', 'aria-label': u.bintang + ' dari 5 bintang' }, stars(u.bintang)),
      u.komentar ? h('p', { class: 'rcard-text' }, u.komentar) : h('p', { class: 'muted' }, 'Tanpa komentar.'),
      h('div', { class: 'rcard-foot' },
        h('span', { class: 'tag' }, u.pesanan_id ? 'Pesanan #' + u.pesanan_id : 'Tanpa nomor pesanan'),
        h('button', { class: 'btn btn-sm btn-danger', type: 'button', onclick: (ev) => hapusUlasan(u, ev.currentTarget) }, 'Hapus')));
  }

  function renderUlasan() {
    const dipotong = rev.jumlah > rev.daftar.length;
    const bagian = [
      h('h2', { class: 'section-title' }, 'Ulasan'),
      h('div', { class: 'stats stats-2' },
        statCard('Jumlah ulasan', String(rev.jumlah)),
        statCard('Rata-rata', rev.jumlah ? rev.rata.toLocaleString('id-ID') + ' / 5' : '\u2013')),
      rev.daftar.length
        ? h('div', { class: 'rlist' }, rev.daftar.map(ulasanCard))
        : h('p', { class: 'empty' }, 'Belum ada ulasan. Pelanggan bisa menulis ulasan dari halaman pesanan setelah pesanannya selesai.'),
      dipotong ? h('p', { class: 'muted' }, 'Menampilkan ' + rev.daftar.length + ' ulasan terbaru dari ' + rev.jumlah + '.') : null
    ];
    // replaceChildren() asli menulis "null" sebagai teks, jadi buang yang kosong dulu.
    panels.ulasan.replaceChildren(...bagian.filter(Boolean));
  }

  async function loadRev() {
    if (loadingRev) return;
    loadingRev = true;
    if (!rev) panels.ulasan.replaceChildren(...skUlasan());
    try {
      const res = await adminReviews();
      if (!alive) return;
      rev = res;
      renderUlasan();
    } catch (e) {
      if (!alive || handleAuth(e)) return;
      if (!rev) {
        panels.ulasan.replaceChildren(h('div', { class: 'state' },
          h('p', null, (e && e.message) || 'Data belum bisa dimuat.'),
          h('button', { class: 'btn btn-solid', type: 'button', onclick: loadRev }, 'Coba lagi')));
      }
    } finally {
      loadingRev = false;
    }
  }

  async function hapusUlasan(u, btn) {
    if (busy) return;
    const yes = await confirmDialog('Hapus ulasan ini?',
      'Ulasan dari ' + (u.nama || 'pelanggan') + (u.pesanan_id ? ' (pesanan #' + u.pesanan_id + ')' : '') +
      ' akan hilang dari toko. Pelanggan itu bisa menulis ulasan lagi dari halaman pesanannya.', 'Ya, hapus');
    if (!yes) return;
    busy = true;
    setLoading(btn, true, 'Memproses\u2026');
    try {
      const res = await adminDeleteReview(u.id);
      if (!alive) return;
      rev = res;
      renderUlasan();
      toast('Ulasan dihapus');
    } catch (e) {
      if (!alive || handleAuth(e)) return;
      toast((e && e.message) || 'Gagal menghapus.');
    } finally {
      busy = false;
      setLoading(btn, false);
    }
  }

  return {
    // Dipanggil tiap tab Keuangan / Ulasan dipilih (dan tiap polling saat tab Keuangan terbuka).
    show(id) {
      if (id === 'keuangan') loadFin();
      else if (id === 'ulasan') loadRev();
    },
    reset() { alive = false; }
  };
}
</file>

<file path="js/api.js">
import { CONFIG } from './config.js';
import { parseRekening } from './util.js';

const KEY = 'dlbeauty_bootstrap_v2';

export const CARA_DEFAULT = [
  { kode: 'antar', label: 'Antar ke rumah', desc: 'Dikirim ke alamatmu, bayar lewat QRIS atau transfer bank', butuh_alamat: true },
  { kode: 'ambil', label: 'Ambil di tempat', desc: '', butuh_alamat: false },
  { kode: 'cod', label: 'COD', desc: 'Ketemuan di titik yang disepakati, bayar tunai saat barang diterima', butuh_alamat: true }
];

const DEMO = {
  pengaturan: {
    nama_toko: 'DL BEAUTY',
    tagline: 'Body Booster Whitening Dosting',
    alamat: '',
    wa_admin: '08532459400',
    logo_url: '', banner_url: '', qris_url: '',
    rekening: 'BCA|1234567890|DL BEAUTY\nBRI|0987654321|DL BEAUTY' // contoh untuk mode demo
  },
  kategori: ['body booster', 'paket hemat'],
  cara_terima: CARA_DEFAULT,
  produk: [
    { id: 'D1', nama: 'Body Booster Whitening Dosting', harga: 75000, kategori: 'body booster', deskripsi: '', foto: '', habis: false },
    { id: 'D2', nama: 'Body Booster 2x Lebih Banyak', harga: 135000, kategori: 'body booster', deskripsi: '', foto: '', habis: false },
    { id: 'D3', nama: 'Body Booster Travel Size', harga: 35000, kategori: 'body booster', deskripsi: '', foto: '', habis: true },
    { id: 'D4', nama: 'Paket Duo Body Booster', harga: 140000, kategori: 'paket hemat', deskripsi: '', foto: '', habis: false }
  ],
  ulasan: { jumlah: 1, rata: 5, daftar: [{ id: 'U1', nama: 'Contoh', bintang: 5, komentar: 'Cepat meresap, tidak lengket.', waktu: '2026-11-06T10:00:00Z' }] }
};

export function readCache() {
  try {
    const raw = localStorage.getItem(KEY);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}

function writeCache(data) {
  try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) { /* abaikan */ }
}

export async function fetchBootstrap() {
  if (!CONFIG.API_URL) return DEMO;
  const url = new URL(CONFIG.API_URL);
  url.searchParams.set('action', 'bootstrap');
  const res = await fetch(url.toString());
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const json = await res.json();
  if (!json.ok) throw new Error(json.error || 'Gagal memuat data');
  writeCache(json.data);
  return json.data;
}

// text/plain menghindari preflight CORS yang tidak didukung Apps Script.
async function post(action, payload, fallbackError) {
  let res;
  try {
    res = await fetch(CONFIG.API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ ...payload, action })
    });
  } catch (e) {
    throw new Error('Koneksi bermasalah. Periksa internet lalu coba lagi.');
  }
  if (!res.ok) throw new Error('Server bermasalah (' + res.status + '). Coba lagi.');
  const json = await res.json();
  if (!json.ok) throw new Error(json.error || fallbackError);
  return json.data;
}

/* ---------- Mode demo: pesanan disimpan di localStorage ---------- */
const DEMO_ORDERS_KEY = 'dlbeauty_demo_orders_v1';
const DEMO_BAYAR = { antar: 'QRIS', ambil: 'Bayar di tempat', cod: 'Tunai (COD)' };
const wait = (ms) => new Promise((r) => setTimeout(r, ms));

function demoLoad() {
  try { return JSON.parse(localStorage.getItem(DEMO_ORDERS_KEY)) || []; } catch (e) { return []; }
}
function demoSave(list) {
  try { localStorage.setItem(DEMO_ORDERS_KEY, JSON.stringify(list)); } catch (e) { /* abaikan */ }
}
function demoFind(list, b) {
  const o = list.find((x) => x.id === Number(b.id) && x.token === String(b.token || ''));
  if (!o) throw new Error('Pesanan tidak ditemukan.');
  return o;
}

// Hanya untuk uji manual di mode demo: window.__demo.setStatus(id, 'DIKEMAS')
if (!CONFIG.API_URL) {
  window.__demo = {
    setStatus(id, status) {
      const list = demoLoad();
      const o = list.find((x) => x.id === Number(id));
      if (o) { o.status = status; demoSave(list); }
    }
  };
}

async function createOrderImpl(payload) {
  if (!CONFIG.API_URL) {
    await wait(400);
    const items = payload.items.map((it) => {
      const p = DEMO.produk.find((x) => x.id === it.id);
      return { produk_id: it.id, nama: p ? p.nama : it.id, harga: p ? p.harga : 0, jumlah: it.jumlah };
    });
    const total = items.reduce((s, it) => s + it.harga * it.jumlah, 0);
    const list = demoLoad();
    const id = list.reduce((m, o) => Math.max(m, o.id), 100) + 1;
    const order = {
      id, token: 'demo' + Math.random().toString(16).slice(2, 10), waktu: new Date().toISOString(),
      nama: payload.nama, cara_terima: payload.cara_terima, cara_bayar: DEMO_BAYAR[payload.cara_terima] || '',
      alamat: payload.alamat || '', catatan: payload.catatan || '', total, status: 'DIPESAN', items, ulasan: null
    };
    list.push(order);
    demoSave(list);
    return { id, token: order.token, total, status: 'DIPESAN', cara_terima: order.cara_terima, cara_bayar: order.cara_bayar };
  }
  return post('createOrder', payload, 'Gagal membuat pesanan.');
}

// Data satu pesanan. id + token wajib cocok; server tidak mengirim pesanan lain.
export async function getOrder(id, token) {
  if (!CONFIG.API_URL) { await wait(150); return demoFind(demoLoad(), { id, token }); }
  return post('getOrder', { id, token }, 'Gagal memuat pesanan.');
}

// Pelanggan memilih cara bayar: 'QRIS' atau nama bank (DIPESAN -> PEMBAYARAN).
async function choosePaymentImpl(id, token, metode) {
  if (!CONFIG.API_URL) {
    await wait(250);
    if (metode !== 'QRIS' && !parseRekening(DEMO.pengaturan.rekening).some((r) => r.bank === metode)) {
      throw new Error('Metode bayar tidak valid.');
    }
    const list = demoLoad();
    const o = demoFind(list, { id, token });
    if (o.cara_terima !== 'antar') throw new Error('Pesanan ini dibayar langsung, tidak lewat QRIS.');
    if (o.status !== 'DIPESAN' && o.status !== 'PEMBAYARAN') throw new Error('Status pesanan sudah ' + o.status + '. Pilihan bayar tidak bisa diubah.');
    // PEMBAYARAN -> PEMBAYARAN dengan metode lain = pelanggan mengganti metode (selama admin belum menerima).
    o.status = 'PEMBAYARAN';
    o.cara_bayar = metode;
    demoSave(list);
    return o;
  }
  return post('choosePayment', { id, token, metode }, 'Gagal memilih cara bayar.');
}

async function submitReviewImpl(id, token, bintang, komentar) {
  if (!CONFIG.API_URL) {
    await wait(250);
    const list = demoLoad();
    const o = demoFind(list, { id, token });
    if (o.status !== 'DIKIRIM') throw new Error('Ulasan bisa ditulis setelah pesanan selesai.');
    if (o.ulasan) throw new Error('Kamu sudah memberi ulasan untuk pesanan ini.');
    o.ulasan = { bintang, komentar: String(komentar || '').slice(0, 300) };
    demoSave(list);
    return o;
  }
  return post('submitReview', { id, token, bintang, komentar }, 'Gagal mengirim ulasan.');
}

// Progress bar sekarang dipasang di tombol pemanggil (lihat setBar/barFull di ui.js), bukan di sini.
export const createOrder = createOrderImpl;
export const choosePayment = choosePaymentImpl;
export const submitReview = submitReviewImpl;
</file>

<file path="js/checkout.js">
import { cart, MAX_QTY } from './cart.js';
import { createOrder, CARA_DEFAULT } from './api.js';
import { h, rupiah } from './util.js';
import { setBar, barFull, bindDialog, closeDialog } from './ui.js';

const PROFILE_KEY = 'dlbeauty_profile_v1';
const ORDERS_KEY = 'dlbeauty_orders_v1';
const ALAMAT_LABEL = { antar: 'Alamat pengiriman', cod: 'Titik pertemuan COD' };

let data = { pengaturan: {}, cara_terima: CARA_DEFAULT };
let dlg = null;
let unsub = null;
let busy = false;
let leaving = false;

export function initCheckout() {
  dlg = document.getElementById('cartDialog');
  bindDialog(dlg);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) closeDialog(dlg); });
  dlg.addEventListener('close', () => { if (unsub) { unsub(); unsub = null; } });
  // Kembali lewat tombol Back (bfcache): status kirim dari halaman sebelumnya harus dibuang.
  window.addEventListener('pageshow', (e) => { if (e.persisted) { leaving = false; busy = false; } });
}

export function setCheckoutData(d) {
  data = {
    pengaturan: d.pengaturan || {},
    cara_terima: d.cara_terima && d.cara_terima.length ? d.cara_terima : CARA_DEFAULT
  };
}

export function openCheckout() {
  renderForm();
  if (!dlg.open) dlg.showModal();
}

/* ---------- Penyimpanan lokal ---------- */
function loadJSON(key, fallback) {
  try { return JSON.parse(localStorage.getItem(key)) || fallback; } catch (e) { return fallback; }
}
function saveJSON(key, val) {
  try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) { /* abaikan */ }
}

/* ---------- Kerangka sheet ---------- */
function shell(title, ...body) {
  return [
    h('div', { class: 'sheet-head' },
      h('h2', { id: 'cartTitle', class: 'sheet-title' }, title),
      h('button', { class: 'icon-btn', type: 'button', 'aria-label': 'Tutup', onclick: () => closeDialog(dlg) }, '\u00d7')
    ),
    ...body
  ];
}

function setDialog(nodes) {
  dlg.replaceChildren(h('div', { class: 'sheet-inner' }, nodes));
}

/* ---------- Form keranjang ---------- */
function renderForm() {
  if (unsub) { unsub(); unsub = null; }

  const caraList = data.cara_terima;
  const profile = loadJSON(PROFILE_KEY, {});
  const alamatToko = data.pengaturan.alamat || '';

  const itemsBox = h('div', { class: 'cart-items' });
  const empty = h('p', { class: 'empty' }, 'Keranjang masih kosong.');
  const totalEl = h('strong', { class: 'total-val' });
  const errEl = h('p', { class: 'form-error', role: 'alert' });

  const radios = caraList.map((c, i) => {
    const input = h('input', { type: 'radio', name: 'cara', value: c.kode, id: 'cara-' + c.kode });
    const desc = c.desc || (c.kode === 'ambil' ? (alamatToko || 'Ambil langsung di toko.') : '');
    const label = h('label', { class: 'opt', for: 'cara-' + c.kode },
      input,
      h('span', { class: 'opt-body' },
        h('span', { class: 'opt-title' }, c.label),
        desc ? h('span', { class: 'opt-desc' }, desc) : null
      )
    );
    return { c, input, label, first: i === 0 };
  });
  const preset = radios.find((r) => r.c.kode === profile.cara) || radios[0];
  preset.input.checked = true;

  const nama = h('input', { id: 'f-nama', class: 'input', type: 'text', autocomplete: 'name', maxlength: '60', value: profile.nama || '' });
  const wa = h('input', { id: 'f-wa', class: 'input', type: 'tel', inputmode: 'tel', autocomplete: 'tel', placeholder: '08xxxxxxxxxx', maxlength: '20', value: profile.wa || '' });
  const alamat = h('textarea', { id: 'f-alamat', class: 'input', rows: '3', maxlength: '300', autocomplete: 'street-address' });
  alamat.value = profile.alamat || '';
  const catatan = h('input', { id: 'f-catatan', class: 'input', type: 'text', maxlength: '200', placeholder: 'Contoh: tolong dibungkus kado' });
  const hp = h('input', { type: 'text', name: 'website', class: 'hp', tabindex: '-1', autocomplete: 'off', 'aria-hidden': 'true' });
  const alamatLabel = h('label', { for: 'f-alamat', class: 'label' });
  const alamatWrap = h('div', { class: 'field' }, alamatLabel, alamat);

  const submit = h('button', { class: 'btn btn-solid btn-block', type: 'submit' }, 'Kirim pesanan');

  const form = h('form', { class: 'checkout', novalidate: true },
    h('fieldset', { class: 'fieldset' },
      h('legend', { class: 'label' }, 'Cara terima pesanan'),
      radios.map((r) => r.label)
    ),
    h('div', { class: 'field' }, h('label', { for: 'f-nama', class: 'label' }, 'Nama penerima'), nama),
    h('div', { class: 'field' }, h('label', { for: 'f-wa', class: 'label' }, 'Nomor WhatsApp'), wa),
    alamatWrap,
    h('div', { class: 'field' }, h('label', { for: 'f-catatan', class: 'label' }, 'Catatan (opsional)'), catatan),
    hp,
    h('div', { class: 'total' }, h('span', null, 'Total'), totalEl),
    errEl,
    submit
  );

  function current() {
    const r = radios.find((x) => x.input.checked) || radios[0];
    return r.c;
  }

  function syncCara() {
    radios.forEach((r) => r.label.classList.toggle('is-on', r.input.checked));
    const c = current();
    alamatWrap.hidden = !c.butuh_alamat;
    alamatLabel.textContent = ALAMAT_LABEL[c.kode] || 'Alamat';
  }
  radios.forEach((r) => r.input.addEventListener('change', syncCara));
  syncCara();

  const prevQty = new Map(); // jumlah terakhir yang digambar, untuk animasi angka berubah

  function row(it) {
    return h('div', { class: 'cart-row' },
      h('div', { class: 'cart-info' },
        h('p', { class: 'cart-name' }, it.nama),
        h('p', { class: 'cart-price' }, rupiah(it.harga))
      ),
      h('div', { class: 'stepper' },
        h('button', { type: 'button', 'aria-label': 'Kurangi ' + it.nama, onclick: () => cart.setQty(it.id, it.jumlah - 1) }, '\u2212'),
        h('span', { class: prevQty.has(it.id) && prevQty.get(it.id) !== it.jumlah ? 'is-pop' : null, 'aria-live': 'polite' }, String(it.jumlah)),
        h('button', { type: 'button', 'aria-label': 'Tambah ' + it.nama, disabled: it.jumlah >= MAX_QTY, onclick: () => cart.setQty(it.id, it.jumlah + 1) }, '+')
      )
    );
  }

  function refresh() {
    const has = cart.items.length > 0;
    itemsBox.replaceChildren(...cart.items.map(row));
    prevQty.clear();
    cart.items.forEach((it) => prevQty.set(it.id, it.jumlah));
    totalEl.textContent = rupiah(cart.total());
    empty.hidden = has;
    form.hidden = !has;
  }
  unsub = cart.subscribe(refresh);
  refresh();

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (busy) return;
    errEl.textContent = '';
    const c = current();
    const v = {
      nama: nama.value.trim(),
      wa: wa.value.trim(),
      alamat: alamat.value.trim(),
      catatan: catatan.value.trim()
    };
    const waDigits = v.wa.replace(/\D/g, '');
    let bad = null;
    if (v.nama.length < 2) bad = [nama, 'Nama penerima wajib diisi.'];
    else if (waDigits.length < 9 || waDigits.length > 15) bad = [wa, 'Nomor WhatsApp tidak valid.'];
    else if (c.butuh_alamat && v.alamat.length < 5) bad = [alamat, (ALAMAT_LABEL[c.kode] || 'Alamat') + ' wajib diisi.'];
    if (bad) { errEl.textContent = bad[1]; bad[0].focus(); return; }

    const snapshot = cart.items.map((it) => ({ ...it }));
    const payload = {
      req_id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random()).slice(0, 36),
      cara_terima: c.kode,
      nama: v.nama,
      wa: waDigits,
      alamat: c.butuh_alamat ? v.alamat : '',
      catatan: v.catatan,
      website: hp.value,
      items: snapshot.map((it) => ({ id: it.id, jumlah: it.jumlah }))
    };

    busy = true;
    setBar(submit, true, 'Mengirim\u2026');
    try {
      const res = await createOrder(payload);
      await barFull(submit);
      saveJSON(PROFILE_KEY, { nama: v.nama, wa: v.wa, alamat: v.alamat, cara: c.kode });
      const orders = loadJSON(ORDERS_KEY, []);
      orders.unshift({
        id: res.id, token: res.token, waktu: Date.now(), total: res.total,
        cara_terima: c.kode,
        items: snapshot.map((it) => ({ nama: it.nama, harga: it.harga, jumlah: it.jumlah }))
      });
      saveJSON(ORDERS_KEY, orders.slice(0, 30));
      cart.clear();
      // Tombol dibiarkan nonaktif sampai halaman berpindah, supaya tidak terkirim dua kali.
      leaving = true;
      location.assign('pesanan.html?id=' + encodeURIComponent(res.id) + '&t=' + encodeURIComponent(res.token));
    } catch (e) {
      errEl.textContent = (e && e.message) || 'Gagal mengirim pesanan. Coba lagi.';
    } finally {
      if (!leaving) {
        busy = false;
        setBar(submit, false, 'Kirim pesanan');
      }
    }
  });

  setDialog(shell('Keranjang kamu', itemsBox, empty, form));
}
</file>

